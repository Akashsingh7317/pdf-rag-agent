# Copy this file to .env and fill in your key. Everything except the API key
# has a sensible default.

# --- AI providers -------------------------------------------------------------
# Option A (free): Groq for answers, photos and voice + a local embedding model.
#   Get a free key at https://console.groq.com/keys
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=local
GROQ_API_KEY=gsk-your-key-here
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Vision model for photos and scanned PDF pages (must accept images):
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Speech-to-text for voice questions:
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# The local embedding model reads up to ~256 tokens per chunk, so keep chunks smaller.
CHUNK_SIZE=1000

# Option B (paid): OpenAI for everything.
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CHUNK_SIZE=1200

# If you change the embedding provider or model, the app marks existing files
# "Needs re-index" and re-indexes them with one click.

# --- Security -----------------------------------------------------------------
# Signs login sessions. Required in production (python -c "import secrets; print(secrets.token_hex(32))").
# Locally it is generated once and stored in data/.secret_key if you leave it unset.
# SECRET_KEY=
# SESSION_DAYS=7
# Set to true when the app is served over HTTPS:
# COOKIE_SECURE=false

# --- Database -----------------------------------------------------------------
# Default: SQLite file in ./data (no setup needed). To use a local MySQL,
# create the database first (CREATE DATABASE pdf_rag;) then:
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/pdf_rag
# Migrations run automatically on start-up; set false if you run "flask db upgrade" yourself.
# AUTO_MIGRATE=true

# --- Features -------------------------------------------------------------------
# Read scanned PDF pages (no text layer) with the vision model:
# OCR_ENABLED=true
# OCR_MAX_PAGES=150
# Write a summary and suggested questions for each file:
# SUMMARY_ENABLED=true
# hybrid (vector + keyword) | vector | keyword
# RETRIEVAL_MODE=hybrid

# --- Background ingestion -----------------------------------------------------
# thread = in-process (default, great for local use)
# celery = Celery worker + Redis (production; used by docker-compose)
# INGESTION_BACKEND=thread
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_STORAGE_URI=memory://
# A file with no progress for this long can be retried or deleted:
# STALE_JOB_MINUTES=30

# --- Limits -------------------------------------------------------------------
# MAX_UPLOAD_MB=200
# MAX_AUDIO_MB=20
# UPLOAD_RATE_LIMIT=10 per minute
# CHAT_RATE_LIMIT=30 per minute
# TRANSCRIBE_RATE_LIMIT=20 per minute
# AUTH_RATE_LIMIT=10 per minute

# --- Retrieval tuning -----------------------------------------------------------
# CHUNK_OVERLAP=200
# RETRIEVAL_K=5
# RETRIEVAL_CANDIDATES=20
# HISTORY_TURNS=3

# --- Docker only: credentials used by docker-compose.yml ----------------------------
# MYSQL_PASSWORD=change-me
# MYSQL_ROOT_PASSWORD=change-me-too
